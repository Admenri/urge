/*
 * config.h -- POSIX / Unix-like configuration header
 *
 * The actual content is assembled by cmake/RubyUnix.cmake.  Splitting the
 * generated defines into blocks keeps this template readable while still
 * producing a plain, self-contained ruby/config.h.
 */
#ifndef INCLUDE_RUBY_CONFIG_H
#define INCLUDE_RUBY_CONFIG_H 1
/* Generated by the CMake build system for @RUBY_ARCH@.  Do not edit. */

/* Feature test macros have to be visible before the first system header. */
@RUBY_FEATURE_TEST_DEFINES@

/* Headers and functions detected on this platform. */
@RUBY_FEATURE_DEFINES@

/* Sizes of basic and platform types. */
@RUBY_SIZEOF_DEFINES@

/* Integer conversion helpers for platform types (rb_pid_t, rb_off_t, ...). */
@RUBY_TYPEDEF_DEFINES@

/* Compiler specific attributes and helpers. */
@RUBY_ATTRIBUTE_DEFINES@

/* Everything else. */
@RUBY_MISC_DEFINES@

#endif /* INCLUDE_RUBY_CONFIG_H */
