#define BUILTIN_BIN(feature) \
    { #feature, feature ## _builtin.binary, sizeof(feature ## _builtin.binary), }
static const struct builtin_binary builtin_binary[] = {
    BUILTIN_BIN(jit_hook),
    BUILTIN_BIN(kernel),
    BUILTIN_BIN(gc),
    BUILTIN_BIN(ractor),
    BUILTIN_BIN(numeric),
    BUILTIN_BIN(io),
    BUILTIN_BIN(dir),
    BUILTIN_BIN(ast),
    BUILTIN_BIN(trace_point),
    BUILTIN_BIN(pack),
    BUILTIN_BIN(pathname_builtin),
    BUILTIN_BIN(warning),
    BUILTIN_BIN(array),
    BUILTIN_BIN(hash),
    BUILTIN_BIN(symbol),
    BUILTIN_BIN(timev),
    BUILTIN_BIN(thread_sync),
    BUILTIN_BIN(nilclass),
    BUILTIN_BIN(marshal),
    BUILTIN_BIN(jit_undef),
    BUILTIN_BIN(prelude),
    BUILTIN_BIN(gem_prelude),
    { NULL, },/* sentinel */
};

#define BUILTIN_BINARY_SIZE 22
STATIC_ASSERT(n_builtin, numberof(builtin_binary) == BUILTIN_BINARY_SIZE + 1);
