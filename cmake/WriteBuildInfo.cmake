# Writes the current short commit into a generated header.  The file is only
# replaced when the commit moves, so an incremental build does not recompile
# system_info.cc just because this script ran again.

execute_process(
  COMMAND git rev-parse --short HEAD
  WORKING_DIRECTORY "${SOURCE_DIR}"
  OUTPUT_VARIABLE commit
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET
  RESULT_VARIABLE status)

if(NOT "${status}" STREQUAL "0" OR commit STREQUAL "")
  set(commit "unknown")
endif()

set(content "// Generated by cmake/WriteBuildInfo.cmake; do not edit.\n#pragma once\n\n#define URGE_GIT_COMMIT \"${commit}\"\n")

get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")

set(current "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" current)
endif()

if(NOT current STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
