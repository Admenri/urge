# A prebuilt static prefix makes configure-time probes usable: in-tree aliases
# cannot be exported into curl's isolated try_compile projects.
set(URGE_MACOS_DEPS_PREFIX "" CACHE PATH "Prefix produced by prepare-deps.py")
if(NOT EXISTS "${URGE_MACOS_DEPS_PREFIX}/lib/libssl.a")
  message(FATAL_ERROR "Build macOS dependencies with app/platform/macos/build-native.sh first, or set URGE_MACOS_DEPS_PREFIX.")
endif()
list(PREPEND CMAKE_PREFIX_PATH "${URGE_MACOS_DEPS_PREFIX}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/cmake")
list(APPEND CMAKE_IGNORE_PREFIX_PATH /opt/homebrew /usr/local /Library/Frameworks/Mono.framework)
set(ENV{PKG_CONFIG_LIBDIR} "${URGE_MACOS_DEPS_PREFIX}/lib/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "${URGE_MACOS_DEPS_PREFIX}/lib/pkgconfig")
set(CMAKE_FIND_FRAMEWORK LAST)
set(CMAKE_FIND_PACKAGE_PREFER_CONFIG ON)

set(ZLIB_BUILD_SHARED OFF CACHE BOOL "" FORCE)
set(ZLIB_BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(ZLIB_USE_STATIC_LIBS ON)
set(ZLIB_ROOT "${URGE_MACOS_DEPS_PREFIX}")
set(ZLIB_INCLUDE_DIR "${URGE_MACOS_DEPS_PREFIX}/include" CACHE PATH "" FORCE)
set(ZLIB_LIBRARY_RELEASE "${URGE_MACOS_DEPS_PREFIX}/lib/libz.a" CACHE FILEPATH "" FORCE)
# FindZLIB supplies an imported ZLIB::ZLIB; the engine still builds zlibstatic
# for Ruby and RGSS script archives from the same pinned source revision.
find_package(ZLIB MODULE REQUIRED)
set(SDLIMAGE_DEPS_SHARED OFF)
set(SDLIMAGE_AVIF_SHARED OFF)
set(SDLIMAGE_PNG_SHARED OFF)
set(SDLIMAGE_TIF_SHARED OFF)
set(SDLIMAGE_WEBP_SHARED OFF)
set(SDLIMAGE_AVIF ON)
set(SDLIMAGE_PNG ON)
set(SDLIMAGE_WEBP ON)
set(SDLIMAGE_BACKEND_IMAGEIO ON)
set(PNG_LIBRARY "${URGE_MACOS_DEPS_PREFIX}/lib/libpng16.a" CACHE FILEPATH "" FORCE)
set(PNG_PNG_INCLUDE_DIR "${URGE_MACOS_DEPS_PREFIX}/include" CACHE PATH "" FORCE)
set(webp_DIR "${URGE_MACOS_DEPS_PREFIX}/share/WebP/cmake" CACHE PATH "" FORCE)

set(CURL_USE_PKGCONFIG OFF)
set(CURL_ZLIB ON CACHE BOOL "" FORCE)
set(CURL_BROTLI ON CACHE BOOL "" FORCE)
set(CURL_ZSTD ON CACHE BOOL "" FORCE)
set(USE_NGHTTP2 ON CACHE BOOL "" FORCE)
set(OPENSSL_USE_STATIC_LIBS ON)
set(OPENSSL_ROOT_DIR "${URGE_MACOS_DEPS_PREFIX}")
set(OPENSSL_INCLUDE_DIR "${URGE_MACOS_DEPS_PREFIX}/include" CACHE PATH "" FORCE)
set(OPENSSL_SSL_LIBRARY "${URGE_MACOS_DEPS_PREFIX}/lib/libssl.a" CACHE FILEPATH "" FORCE)
set(OPENSSL_CRYPTO_LIBRARY "${URGE_MACOS_DEPS_PREFIX}/lib/libcrypto.a" CACHE FILEPATH "" FORCE)
foreach(dep BROTLI ZSTD NGHTTP2)
  set(${dep}_USE_STATIC_LIBS ON)
  set(${dep}_INCLUDE_DIR "${URGE_MACOS_DEPS_PREFIX}/include" CACHE PATH "" FORCE)
endforeach()
set(BROTLIDEC_LIBRARY "${URGE_MACOS_DEPS_PREFIX}/lib/libbrotlidec.a" CACHE FILEPATH "" FORCE)
set(BROTLICOMMON_LIBRARY "${URGE_MACOS_DEPS_PREFIX}/lib/libbrotlicommon.a" CACHE FILEPATH "" FORCE)
set(ZSTD_LIBRARY "${URGE_MACOS_DEPS_PREFIX}/lib/libzstd.a" CACHE FILEPATH "" FORCE)
set(NGHTTP2_LIBRARY "${URGE_MACOS_DEPS_PREFIX}/lib/libnghttp2.a" CACHE FILEPATH "" FORCE)
# Use the OS trust store and IDNA implementation; neither needs a downloaded
# CA bundle nor Homebrew's libidn2 at runtime.
set(USE_APPLE_SECTRUST ON CACHE BOOL "" FORCE)
set(USE_APPLE_IDN ON CACHE BOOL "" FORCE)
set(USE_LIBIDN2 OFF CACHE BOOL "" FORCE)
set(CURL_CA_BUNDLE none CACHE STRING "" FORCE)
set(CURL_CA_PATH none CACHE STRING "" FORCE)
